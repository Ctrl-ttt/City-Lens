# Never commit the real .env file. Model mode never silently falls back to samples.
CITYLENS_PROVIDER=live
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# Empty uses the same host as DASHSCOPE_BASE_URL with /api-ws/v1/realtime.
DASHSCOPE_REALTIME_URL=
# CITYLENS_PROVIDER=realtime selects realtime by default; read mode still uses HTTP.
# Only for explicitly labelled UI integration: bicycle, stairs, sign, empty, unclear
CITYLENS_SAMPLE_SCENE=bicycle
# Distance filter: events whose box implies a rough pinhole estimate beyond
# CITYLENS_MAX_DISTANCE_M are dropped before rules/speech. <=0 disables.
# Estimation uses typical per-category heights and CITYLENS_CAMERA_HFOV_deg of
# the unzoomed wide view; it is a coarse filter, not a measurement.
CITYLENS_MAX_DISTANCE_M=5
CITYLENS_CAMERA_HFOV_DEG=75
# Frame-to-frame speech dedup: the same announcement key is not re-spoken
# within this many seconds (per session, server-side; <=0 disables).
CITYLENS_SPEECH_REPEAT_SECONDS=4

