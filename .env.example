# Never commit the real .env file. Model mode never silently falls back to samples.
CITYLENS_PROVIDER=live
# Optional Skylight food recognition plugin. It is user-triggered and does not
# alter the environment/realtime recognition pipeline.
CITYLENS_SKYLIGHT_ENABLED=true
CITYLENS_SKYLIGHT_MODEL=
# Food recognition timeout in seconds (default 22); independent of the 8s environment budget.
CITYLENS_SKYLIGHT_TIMEOUT=22
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# Empty uses the same host as DASHSCOPE_BASE_URL with /api-ws/v1/realtime.
DASHSCOPE_REALTIME_URL=
# CITYLENS_PROVIDER=realtime selects realtime by default; read mode still uses HTTP.
# Only for explicitly labelled UI integration: stairs, sign, empty, unclear
CITYLENS_SAMPLE_SCENE=empty
# Apparent-size proximity only affects ranking; objects are no longer deleted
# using a guessed 5 m cutoff. CITYLENS_MAX_DISTANCE_M is deprecated/ignored by APIs.
# Flat input uses the actual unzoomed horizontal FOV; panorama faces use 90 degrees.
# No metric distance is spoken; unknown-size/ground-plane objects keep unknown range.
CITYLENS_CAMERA_HFOV_DEG=75
# Frame-to-frame speech dedup: the same announcement key is not re-spoken
# within this many seconds (per session, server-side; <=0 disables).
CITYLENS_SPEECH_REPEAT_SECONDS=4
# Model-reported confidence below this floor is not spoken, unless the label is
# high-risk (stairs, cars...), which is then announced with "疑似" hazy wording.
CITYLENS_MIN_CONFIDENCE=0.5
# Continuous objects (stairs, escalators, crosswalks...) stay in view for many
# seconds; their re-announcement window widens to at least this many seconds.
CITYLENS_CONTINUOUS_REPEAT_SECONDS=12
# Only events scoring strictly above this value are automatically spoken.
CITYLENS_SPEECH_SCORE_THRESHOLD=70
# low: direction/3 items, medium: direction+range/2 items, high: direction+range+speed/1 item.
CITYLENS_SPEECH_DETAIL_LEVEL=medium

